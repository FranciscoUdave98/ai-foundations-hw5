# Copy this file to .env and add your own key. .env is git-ignored.
# Every agent calls gpt-6-luna through Portkey with this key.
PORTKEY_API_KEY=your-portkey-key-here

# Optional: use an MCP server you started yourself over HTTP instead of
# letting the backend launch its own stdio copy.
# CAMPUS_MCP_URL=http://127.0.0.1:8001/mcp
